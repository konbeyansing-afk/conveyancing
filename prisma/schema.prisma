generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TRAINER
  TRAINEE
  VA
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_PENDING
  BLOCKED
  COMPLETED
}

enum WorkPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/**
 * The Australian state/territory a matter's conveyancing rules follow.
 * Only QLD and NSW are supported today; the enum and the workflow
 * configuration in src/lib/matter-stage.ts are both designed so VIC/SA/WA/
 * ACT/TAS/NT can be added later without restructuring either.
 */
enum Jurisdiction {
  QLD
  NSW
}

enum MatterType {
  PURCHASE
  SALE
}

/**
 * Where a property transaction (matter) currently sits in its conveyancing
 * lifecycle — independent of WorkStatus, which describes what the VA's own
 * work is doing right now. Stable, jurisdiction-agnostic identifiers: which
 * of these are valid, and in what order, is a property of the matter's
 * Jurisdiction, not of this enum — see MATTER_WORKFLOWS in
 * src/lib/matter-stage.ts, the single source of truth for that mapping and
 * for human-friendly labels. A handful of values exist for exactly one
 * jurisdiction today (e.g. BUILDING_PEST is QLD-only, CONTRACT_EXCHANGE is
 * NSW-only); most are shared because the concept is genuinely the same.
 */
enum MatterStage {
  MATTER_OPENING
  CONTRACT_REVIEW
  CONTRACT_SIGNED // QLD
  CONTRACT_EXCHANGE // NSW
  COOLING_OFF
  FINANCE
  BUILDING_PEST // QLD
  SEARCHES
  PRE_SETTLEMENT
  SETTLEMENT_PREPARATION // NSW
  PEXA
  SETTLEMENT_BOOKED
  SETTLEMENT
  POST_SETTLEMENT
  LODGEMENT_REGISTRATION // NSW
  MATTER_FINALISATION
  COMPLETED
}

/**
 * The status of one checklist task on one matter — deliberately the same
 * six values as Work Status plus NOT_APPLICABLE (a task a particular matter
 * genuinely does not need, e.g. a Strata task on a non-strata property),
 * kept as its own enum rather than reusing WorkStatus because "not
 * applicable" has no meaning for a WorkItem's own status.
 */
enum ChecklistTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_PENDING
  BLOCKED
  COMPLETED
  NOT_APPLICABLE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
}

model User {
  id                     String              @id @default(cuid())
  name                   String
  email                  String              @unique
  passwordHash           String
  /**
   * Set when an account is created or its password is reset by an admin.
   */
  mustChangePassword     Boolean             @default(false)
  passwordChangedAt      DateTime?
  role                   Role                @default(TRAINEE)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  enrollments            Enrollment[]
  lessonProgress         LessonProgress[]
  quizAttempts           QuizAttempt[]
  completionRecords      CompletionRecord[]
  notifications          Notification[]
  stageApprovalsReceived StageApproval[]     @relation("TraineeStageApprovals")
  stageApprovalsGranted  StageApproval[]     @relation("GrantedStageApprovals")
  certificates           Certificate[]       @relation("EarnedCertificates")
  certificatesIssued     Certificate[]       @relation("IssuedCertificates")
  trainerAssignments     TrainerAssignment[] @relation("TrainerOf")
  assignedTrainers       TrainerAssignment[] @relation("TraineeOf")
  notesAbout             TraineeNote[]       @relation("NotesAbout")
  notesWritten           TraineeNote[]       @relation("NotesWritten")
  workItems              WorkItem[]          @relation("WorkItemOwner")
  workItemsDeleted       WorkItem[]          @relation("WorkItemDeletedBy")
  workActivity           WorkActivity[]
  workAdminNotes         WorkAdminNote[]
  checklistTasksAssigned ChecklistTask[]     @relation("ChecklistTaskAssignee")
  checklistTasksCompleted ChecklistTask[]    @relation("ChecklistTaskCompletedBy")
}

/**
 * A VA's unit of work: one task, matter or piece of follow-up. `status` and
 * the timestamp/blocked fields describe the *current* state only — every
 * change to them is additionally logged to WorkActivity, which is the audit
 * trail and is never overwritten. A VA is limited to one WorkItem with
 * status=IN_PROGRESS at a time (enforced in the server actions, not here);
 * everything else is history or queued.
 * Soft-deleted rather than removed, so an admin deletion is auditable — see
 * deletedAt/deletedById.
 */
model WorkItem {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation("WorkItemOwner", fields: [userId], references: [id], onDelete: Cascade)
  title               String
  matterReference     String?
  clientReference     String?
  /**
   * Defaults to QLD: the only jurisdiction this platform has ever supported
   * (see README — "QLD Conveyancing is the first program"), so it is the
   * only safe default for rows that predate this field.
   */
  jurisdiction        Jurisdiction    @default(QLD)
  matterType          MatterType?
  matterStage         MatterStage     @default(MATTER_OPENING)
  status              WorkStatus      @default(NOT_STARTED)
  priority            WorkPriority    @default(NORMAL)
  notes               String?
  blockedReason       String?
  blockedNeeds        String?
  startedAt           DateTime?
  completedAt         DateTime?
  estimatedCompletion DateTime?
  deletedAt           DateTime?
  deletedById         String?
  deletedBy           User?           @relation("WorkItemDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  activity            WorkActivity[]
  adminNotes          WorkAdminNote[]
  checklistTasks      ChecklistTask[]

  @@index([userId, status])
  @@index([userId, deletedAt])
  @@index([status, deletedAt])
  @@index([completedAt])
  @@index([userId, matterStage])
  @@index([matterStage, deletedAt])
  @@index([jurisdiction, deletedAt])
}

/**
 * One row per status change (and per plain note, where previousStatus equals
 * newStatus), and separately per matter-stage change — the append-only
 * history a WorkItem's current fields cannot provide on their own. `userId`
 * is always the authenticated actor who made the change, never a
 * client-supplied value. previousMatterStage/newMatterStage are set only on
 * a stage-change entry (null otherwise), the same way previousStatus/
 * newStatus are always set but equal on a plain note.
 */
model WorkActivity {
  id                  String       @id @default(cuid())
  workItemId          String
  workItem            WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousStatus      WorkStatus?
  newStatus           WorkStatus
  previousMatterStage MatterStage?
  newMatterStage      MatterStage?
  note                String?
  createdAt           DateTime     @default(now())

  @@index([workItemId, createdAt])
}

/**
 * An admin-only annotation on a WorkItem, kept distinct from the VA's own
 * notes/activity so the two are never confused in the UI.
 */
model WorkAdminNote {
  id          String   @id @default(cuid())
  workItemId  String
  workItem    WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  adminUserId String
  adminUser   User     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  note        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([workItemId, createdAt])
}

/**
 * One instantiated checklist item on one matter, generated from the
 * Jurisdiction+MatterType template in src/lib/checklist-templates.ts when
 * the matter's checklist is first opened (see ensureChecklistForWorkItem).
 * `taskKey` ties a row back to its template definition — the source of its
 * section/stage/title/required/dependsOn, none of which are duplicated
 * here, so a template wording fix applies to every matter without a
 * migration. Rows are never regenerated once created (a VA's notes/status
 * on a task must survive a later template tweak), only added if the
 * template gains a new key the matter doesn't have yet.
 */
model ChecklistTask {
  id            String              @id @default(cuid())
  workItemId    String
  workItem      WorkItem            @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  taskKey       String
  status        ChecklistTaskStatus @default(NOT_STARTED)
  notes         String?
  blockedReason String?
  dueDate       DateTime?
  priority      WorkPriority?
  assignedToId  String?
  assignedTo    User?               @relation("ChecklistTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  completedById String?
  completedBy   User?               @relation("ChecklistTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([workItemId, taskKey])
  @@index([workItemId, status])
}

model Program {
  id                String                @id @default(cuid())
  slug              String                @unique
  title             String
  description       String?
  coverImageUrl     String?
  isPublished       Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  courses           Course[]
  stages            Stage[]
  resourceItems     ResourceLibraryItem[]
  completionRecords CompletionRecord[]
  certificates      Certificate[]
}

model Stage {
  id          String  @id @default(cuid())
  programId   String
  program     Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String?
  order       Int     @default(0)
  isPublished Boolean @default(false)

  prerequisiteStageId String?
  prerequisiteStage   Stage?  @relation("StagePrerequisite", fields: [prerequisiteStageId], references: [id], onDelete: SetNull)
  unlocksStages       Stage[] @relation("StagePrerequisite")

  requireAllLessons      Boolean @default(true)
  requireQuizPass        Boolean @default(false)
  gatingQuizId           String? @unique
  gatingQuiz             Quiz?   @relation(fields: [gatingQuizId], references: [id], onDelete: SetNull)
  minQuizScore           Int?
  requireTrainerApproval Boolean @default(false)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  courses           Course[]
  approvals         StageApproval[]
  completionRecords CompletionRecord[]

  @@unique([programId, slug])
}

model StageApproval {
  id           String   @id @default(cuid())
  stageId      String
  stage        Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("TraineeStageApprovals", fields: [userId], references: [id], onDelete: Cascade)
  approvedById String
  approvedBy   User     @relation("GrantedStageApprovals", fields: [approvedById], references: [id], onDelete: Cascade)
  approvedAt   DateTime @default(now())
  notes        String?

  @@unique([stageId, userId])
}

model Course {
  id                String             @id @default(cuid())
  programId         String
  program           Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  stageId           String?
  stage             Stage?             @relation(fields: [stageId], references: [id], onDelete: Cascade)
  slug              String
  title             String
  description       String?
  isPublished       Boolean            @default(false)
  order             Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  modules           Module[]
  quizzes           Quiz[]
  enrollments       Enrollment[]
  completionRecords CompletionRecord[]

  @@unique([programId, slug])
}

model Module {
  id                String             @id @default(cuid())
  courseId          String
  course            Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title             String
  order             Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lessons           Lesson[]
  completionRecords CompletionRecord[]
}

model Lesson {
  id                    String                @id @default(cuid())
  moduleId              String
  module                Module                @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  slug                  String
  title                 String
  description           String?
  lessonType            LessonType            @default(STANDARD)
  difficulty            Difficulty            @default(BEGINNER)
  estimatedMinutes      Int?
  completionRequirement CompletionRequirement @default(VIEW_ALL)
  isPublished           Boolean               @default(false)
  order                 Int                   @default(0)
  content               Json?
  trainerNotes          Json?
  videoAssetId          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  attachments           LessonAttachment[]
  quiz                  Quiz?
  progress              LessonProgress[]

  @@unique([moduleId, slug])
}

enum LessonType {
  STANDARD
  VIDEO
  READING
  PRACTICAL
  QUIZ
  ASSESSMENT
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CompletionRequirement {
  VIEW_ALL
  PASS_QUIZ
}

model LessonAttachment {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title     String
  url       String
  fileType  String
  sizeBytes Int?
  createdAt DateTime @default(now())
}

model Quiz {
  id             String        @id @default(cuid())
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId       String?       @unique
  lesson         Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title          String
  passingScore   Int           @default(80)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  questions      Question[]
  attempts       QuizAttempt[]
  gatingForStage Stage?
}

model Question {
  id          String       @id @default(cuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt      String
  type        QuestionType @default(MULTIPLE_CHOICE)
  explanation String?
  order       Int          @default(0)
  choices     Choice[]
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score       Int
  passed      Boolean
  answers     Json
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
}

model Enrollment {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

enum CompletionScope {
  MODULE
  COURSE
  STAGE
  PROGRAM
}

/**
 * An immutable milestone: the moment a trainee first satisfied everything a
 * module, course, stage or program requires. The boolean is always recomputed
 * from real progress (see src/lib/completion.ts); this table exists to remember
 * *when* it first became true, which recomputation cannot tell you and which
 * certificates depend on.
 * Exactly one of moduleId/courseId/stageId/programId is set, matching `scope`.
 * Postgres treats NULLs as distinct, so the four unique indexes each constrain
 * only the scope they belong to.
 */
model CompletionRecord {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       CompletionScope
  moduleId    String?
  module      Module?         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseId    String?
  course      Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  stageId     String?
  stage       Stage?          @relation(fields: [stageId], references: [id], onDelete: Cascade)
  programId   String?
  program     Program?        @relation(fields: [programId], references: [id], onDelete: Cascade)
  completedAt DateTime        @default(now())

  @@unique([userId, scope, moduleId])
  @@unique([userId, scope, courseId])
  @@unique([userId, scope, stageId])
  @@unique([userId, scope, programId])
  @@index([userId, scope])
}

enum CertificateStatus {
  /**
   * Program is complete; a trainer or admin still has to sign it off.
   */
  PENDING_APPROVAL
  ISSUED
  REVOKED
}

/**
 * A single-row-per-year atomic counter behind certificate numbers
 * (CA-2026-000042). Allocating a number is one `UPDATE ... SET value =
 * value + 1 WHERE year = $1 RETURNING value` (via Prisma's `increment`),
 * which Postgres serialises at the row level — concurrent callers can never
 * be handed the same value, no matter how many race at once. This replaces
 * an earlier read-latest-then-increment approach that could and did collide
 * under real concurrent program completions.
 */
model CertificateSequence {
  year  Int @id
  value Int @default(0)
}

/**
 * A certificate is only ever created once a program is genuinely complete, and
 * only becomes ISSUED when a trainer or admin signs it off — which is where a
 * human confirms the things the system cannot yet verify on its own (see the
 * simulator-competency limitation in the README).
 * Trainee name, program title and organisation are snapshotted so that renaming
 * a program later does not rewrite an already-issued certificate.
 */
model Certificate {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation("EarnedCertificates", fields: [userId], references: [id], onDelete: Cascade)
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  certificateNumber String            @unique
  verificationCode  String            @unique
  status            CertificateStatus @default(PENDING_APPROVAL)

  traineeName         String
  programTitle        String
  issuingOrganisation String

  completedAt   DateTime
  issuedAt      DateTime?
  issuedById    String?
  issuedBy      User?     @relation("IssuedCertificates", fields: [issuedById], references: [id], onDelete: SetNull)
  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, programId])
  @@index([status])
}

/**
 * Which trainees a trainer is responsible for. A trainer only ever sees the
 * trainees assigned to them; an admin sees everyone.
 */
/**
 * A trainer's running observations about a trainee — the qualitative half of
 * supervision that progress percentages cannot carry. Visible to trainers and
 * admins, never to the trainee it is about.
 */
model TraineeNote {
  id        String   @id @default(cuid())
  traineeId String
  trainee   User     @relation("NotesAbout", fields: [traineeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("NotesWritten", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([traineeId, createdAt])
}

model TrainerAssignment {
  id         String   @id @default(cuid())
  trainerId  String
  trainer    User     @relation("TrainerOf", fields: [trainerId], references: [id], onDelete: Cascade)
  traineeId  String
  trainee    User     @relation("TraineeOf", fields: [traineeId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([trainerId, traineeId])
  @@index([trainerId])
}

model ResourceLibraryItem {
  id          String   @id @default(cuid())
  programId   String?
  program     Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  title       String
  description String?
  url         String
  fileType    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
