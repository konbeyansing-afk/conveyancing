{
  "name": "conveyancing-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--use-system-ca next dev",
    "postinstall": "prisma generate",
    "build": "next build",
    "start": "cross-env NODE_OPTIONS=--use-system-ca next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--use-system-ca vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--use-system-ca vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "cross-env NODE_OPTIONS=--use-system-ca vitest run tests/integration",
    "test:routes": "cross-env NODE_OPTIONS=--use-system-ca vitest run tests/http",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/html": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "happy-dom": "^20.11.1",
    "lucide-react": "^1.28.0",
    "motion": "^13.3.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.20.0"
}
